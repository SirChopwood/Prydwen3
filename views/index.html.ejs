<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Louis Mayes</title>
        <link rel="icon" type="image/x-icon" href="/images/favicon.ico">
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Cabin&family=JetBrains+Mono&display=swap" rel="stylesheet">
        <% if (environment === 'production') { %>
            <% for (let sheet of manifest['src/main.js'].css) {%>
            <link rel="stylesheet" href="/<%=sheet%>" />
        <% } } %>
    </head>
    <body>
        <div id="app"></div>
        <% if (environment === 'production') { %>
            <script type="module" src="/<%= manifest['src/main.js'].file %>"></script>
        <% } else { %>
            <script type="module" src="http://localhost:5173/@vite/client"></script>
            <script type="module" src="http://localhost:5173/src/main.ts"></script>
        <% } %>
    </body>
</html>